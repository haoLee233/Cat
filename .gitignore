# ==========================================
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# ==========================================
# 3. 本地 AI 工具缓存（根据截图完善）
# ==========================================
/.codely-cli
/.codely.packages  # 补：截图里出现的另一个本地缓存目录
.codelyignore      # 补：如果它是工具内部用的，不要同步给队友

# ==========================================
# 4. 系统垃圾与临时文件
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.log
BuildScenes.log
Editor.log


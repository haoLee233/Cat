# 自动规范换行符，防止跨平台冲突（最重要）
* text=auto eol=lf

# 团结引擎特有的文本资产，强制按文本处理，方便合并
*.unity text
*.prefab text
*.asset text
*.meta text
*.mat text
*.json text

# 明确标记二进制文件，告诉 Git 不要尝试合并它们（但也绝对不要加 LFS 规则）
*.png binary
*.jpg binary
*.jpeg binary
*.fbx binary
*.wav binary
*.mp3 binary
*.psd binary
*.m4v binary
*.mp4 binary